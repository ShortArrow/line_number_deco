{
  "name": "line-number-deco",
  "displayName": "LineNumberDeco",
  "description": "Show relative line numbers beside the absolute ones, as decorations",
  "publisher": "ShortArrow",
  "version": "0.2.0",
  "sponsor": {
    "url": "https://github.com/sponsors/ShortArrow"
  },
  "engines": {
    "vscode": "^1.76.0"
  },
  "packageManager": "pnpm@11.22.0",
  "icon": "images/icon.png",
  "keywords": [
    "vim",
    "neovim",
    "nvim",
    "helix",
    "emacs",
    "rownumber",
    "relative",
    "linenumber",
    "number"
  ],
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lineNumberDeco",
          "title": "LineNumberDeco",
          "icon": "images/icon-activity.svg"
        }
      ]
    },
    "views": {
      "lineNumberDeco": [
        {
          "type": "webview",
          "id": "lineNumberDeco.settings",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "line-number-deco.enableRainbow",
        "title": "LineNumberDeco: Enable rainbow for workspace"
      },
      {
        "command": "line-number-deco.disableRainbow",
        "title": "LineNumberDeco: Disable rainbow for workspace"
      },
      {
        "command": "line-number-deco.enableRainbowForUser",
        "title": "LineNumberDeco: Enable rainbow for user"
      },
      {
        "command": "line-number-deco.disableRainbowForUser",
        "title": "LineNumberDeco: Disable rainbow for user"
      },
      {
        "command": "line-number-deco.updateColorAtCenterOfRainbow",
        "title": "LineNumberDeco: Update color of the rainbow center for workspace"
      },
      {
        "command": "line-number-deco.updateColorAtCenterOfRainbowForUser",
        "title": "LineNumberDeco: Update color of the rainbow center for user"
      },
      {
        "command": "line-number-deco.updateColorAtActiveRowNumber",
        "title": "LineNumberDeco: Update color of the current line number for workspace"
      },
      {
        "command": "line-number-deco.updateColorAtActiveRowNumberForUser",
        "title": "LineNumberDeco: Update color of the current line number for user"
      },
      {
        "command": "line-number-deco.updateColorAtInactiveRowNumber",
        "title": "LineNumberDeco: Update color of inactive line numbers for workspace"
      },
      {
        "command": "line-number-deco.updateColorAtInactiveRowNumberForUser",
        "title": "LineNumberDeco: Update color of inactive line numbers for user"
      },
      {
        "command": "line-number-deco.updateColorAtRepeatingDigits",
        "title": "LineNumberDeco: Update color of repeating digits for workspace"
      },
      {
        "command": "line-number-deco.updateColorAtRepeatingDigitsForUser",
        "title": "LineNumberDeco: Update color of repeating digits for user"
      },
      {
        "command": "line-number-deco.updateColorAtSequentialDigits",
        "title": "LineNumberDeco: Update color of sequential digits for workspace"
      },
      {
        "command": "line-number-deco.updateColorAtSequentialDigitsForUser",
        "title": "LineNumberDeco: Update color of sequential digits for user"
      },
      {
        "command": "line-number-deco.enableRelativeLineNumbers",
        "title": "LineNumberDeco: Enable relative line numbers for workspace"
      },
      {
        "command": "line-number-deco.enableRelativeLineNumbersForUser",
        "title": "LineNumberDeco: Enable relative line numbers for user"
      },
      {
        "command": "line-number-deco.disableRelativeLineNumbers",
        "title": "LineNumberDeco: Disable relative line numbers for workspace"
      },
      {
        "command": "line-number-deco.disableRelativeLineNumbersForUser",
        "title": "LineNumberDeco: Disable relative line numbers for user"
      },
      {
        "command": "line-number-deco.enableRepeatingDigits",
        "title": "LineNumberDeco: Enable repeating digits color for workspace"
      },
      {
        "command": "line-number-deco.disableRepeatingDigits",
        "title": "LineNumberDeco: Disable repeating digits color for workspace"
      },
      {
        "command": "line-number-deco.enableRepeatingDigitsForUser",
        "title": "LineNumberDeco: Enable repeating digits color for user"
      },
      {
        "command": "line-number-deco.disableRepeatingDigitsForUser",
        "title": "LineNumberDeco: Disable repeating digits color for user"
      },
      {
        "command": "line-number-deco.enableSequentialDigits",
        "title": "LineNumberDeco: Enable sequential digits color for workspace"
      },
      {
        "command": "line-number-deco.disableSequentialDigits",
        "title": "LineNumberDeco: Disable sequential digits color for workspace"
      },
      {
        "command": "line-number-deco.enableSequentialDigitsForUser",
        "title": "LineNumberDeco: Enable sequential digits color for user"
      },
      {
        "command": "line-number-deco.disableSequentialDigitsForUser",
        "title": "LineNumberDeco: Disable sequential digits color for user"
      },
      {
        "command": "line-number-deco.enableDiagnostics",
        "title": "LineNumberDeco: Enable diagnostics color for workspace"
      },
      {
        "command": "line-number-deco.disableDiagnostics",
        "title": "LineNumberDeco: Disable diagnostics color for workspace"
      },
      {
        "command": "line-number-deco.enableDiagnosticsForUser",
        "title": "LineNumberDeco: Enable diagnostics color for user"
      },
      {
        "command": "line-number-deco.disableDiagnosticsForUser",
        "title": "LineNumberDeco: Disable diagnostics color for user"
      },
      {
        "command": "line-number-deco.updateColorAtErrorLines",
        "title": "LineNumberDeco: Update color of error lines for workspace"
      },
      {
        "command": "line-number-deco.updateColorAtErrorLinesForUser",
        "title": "LineNumberDeco: Update color of error lines for user"
      },
      {
        "command": "line-number-deco.updateColorAtWarningLines",
        "title": "LineNumberDeco: Update color of warning lines for workspace"
      },
      {
        "command": "line-number-deco.updateColorAtWarningLinesForUser",
        "title": "LineNumberDeco: Update color of warning lines for user"
      },
      {
        "command": "line-number-deco.showSettingsPanel",
        "title": "LineNumberDeco: Show settings panel"
      },
      {
        "command": "line-number-deco.hideSettingsPanel",
        "title": "LineNumberDeco: Hide settings panel"
      },
      {
        "command": "line-number-deco.toggleSettingsPanel",
        "title": "LineNumberDeco: Toggle settings panel"
      }
    ],
    "configuration": {
      "title": "LineNumberDeco",
      "properties": {
        "LineNumberDeco.enableRelativeLine": {
          "type": "boolean",
          "default": true,
          "description": "Show relative line numbers"
        },
        "LineNumberDeco.centerColorOfRainbow": {
          "type": "string",
          "format": "color",
          "default": "#0000ff",
          "description": "Color at the center of the rainbow, on the current line"
        },
        "LineNumberDeco.foregroundColorOfRepeatingDigits": {
          "type": "string",
          "format": "color",
          "default": "#00ff00",
          "description": "Color of repeating-digit line numbers (11, 22, 333)"
        },
        "LineNumberDeco.foregroundColorOfSequentialDigits": {
          "type": "string",
          "format": "color",
          "default": "#ffa500",
          "description": "Color of sequential-digit line numbers (123, 543, 10)"
        },
        "LineNumberDeco.enableRainbow": {
          "type": "boolean",
          "default": false,
          "description": "Color each line number by its distance from the cursor"
        },
        "LineNumberDeco.enableRepeatingDigits": {
          "type": "boolean",
          "default": false,
          "description": "Give repeating-digit line numbers (11, 22, 333) their own color"
        },
        "LineNumberDeco.enableSequentialDigits": {
          "type": "boolean",
          "default": false,
          "description": "Give sequential-digit line numbers (123, 543, 10) their own color — the poker mode"
        },
        "LineNumberDeco.activeForeground": {
          "type": "string",
          "default": "",
          "format": "color",
          "description": "Color of the current line's number; empty uses the theme color"
        },
        "LineNumberDeco.foreground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Color of the other line numbers; empty uses the theme color"
        },
        "LineNumberDeco.enableDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Color line numbers on lines with errors or warnings"
        },
        "LineNumberDeco.errorForeground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Color of line numbers on error lines; empty uses the theme color"
        },
        "LineNumberDeco.warningForeground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Color of line numbers on warning lines; empty uses the theme color"
        }
      }
    },
    "colors": [
      {
        "id": "LineNumberDeco.activeForeground",
        "description": "Color for active relative line number",
        "defaults": {
          "dark": "editorLineNumber.activeForeground",
          "light": "editorLineNumber.activeForeground",
          "highContrast": "editorLineNumber.activeForeground",
          "highContrastLight": "editorLineNumber.activeForeground"
        }
      },
      {
        "id": "LineNumberDeco.foreground",
        "description": "Color for relative line number",
        "defaults": {
          "dark": "editorLineNumber.foreground",
          "light": "editorLineNumber.foreground",
          "highContrast": "editorLineNumber.foreground",
          "highContrastLight": "editorLineNumber.foreground"
        }
      }
    ]
  },
  "scripts": {
    "clean": "rimraf ./out",
    "publish": "pnpm run compile && vsce publish",
    "package": "pnpm run compile",
    "vscode:prepublish": "pnpm run compile",
    "compile": "node scripts/bundle-webview.mjs && tsc -p src/webview --noEmit && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run clean && pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "pnpm run pretest && node ./out/test/runTest.js",
    "generate": "pnpm dlx ts-node ./src/generater/fromPackageJson.ts"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.76.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.34.0",
    "glob": "^8.1.0",
    "mocha": "^11.0.0",
    "ovsx": "^1.1.1",
    "rimraf": "^5.0.1",
    "typescript": "^4.9.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShortArrow/line_number_deco.git"
  }
}
