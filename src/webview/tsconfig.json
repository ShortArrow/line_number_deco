{
	/* The webview script runs in a browser, not in the extension host: it is
	   typechecked here with DOM types and never compiled by the root project,
	   whose node-typed tsc must not see this code. esbuild emits the bundle. */
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "node",
		"target": "ES2020",
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"types": [],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"panel.ts",
		"../colorConvert.ts",
		"../panelState.ts"
	]
}
